{
  "title": "Contact Northwind Studio",
  "path": "/contact",
  "ast": {
    "version": 1,
    "schemaVersion": "2026-03",
    "meta": {
      "title": "Contact Northwind Studio",
      "description": "Contact Northwind Studio fixture page for release gates."
    },
    "sections": [
      {
        "id": "sec_nav",
        "blocks": [
          {
            "id": "blk_navbar",
            "type": "navbar",
            "props": {
              "logoText": "Northwind Studio",
              "items": [
                {
                  "id": "nav_home",
                  "label": "Home",
                  "target": {
                    "url": "/"
                  }
                },
                {
                  "id": "nav_about",
                  "label": "About",
                  "target": {
                    "url": "/about"
                  }
                },
                {
                  "id": "nav_contact",
                  "label": "Contact",
                  "target": {
                    "url": "/contact"
                  }
                }
              ],
              "ctaButton": {
                "label": "Start a project",
                "target": {
                  "url": "/contact"
                }
              }
            }
          }
        ]
      },
      {
        "id": "sec_contact_hero",
        "blocks": [
          {
            "id": "blk_contact_hero",
            "type": "hero",
            "props": {
              "headline": "Tell us about your project",
              "subheadline": "We reply within one working day."
            }
          }
        ]
      },
      {
        "id": "sec_contact_form",
        "blocks": [
          {
            "id": "blk_contact_form",
            "type": "form",
            "props": {
              "headline": "Send a message",
              "formId": "contact",
              "submitButtonText": "Send message",
              "successMessage": "Thanks. We will reply within one working day.",
              "fields": [
                {
                  "id": "field_name",
                  "name": "name",
                  "label": "Your name",
                  "type": "text",
                  "required": true
                },
                {
                  "id": "field_email",
                  "name": "email",
                  "label": "Email address",
                  "type": "email",
                  "required": true
                },
                {
                  "id": "field_message",
                  "name": "message",
                  "label": "What can we help with?",
                  "type": "textarea",
                  "required": true
                }
              ]
            }
          }
        ]
      },
      {
        "id": "sec_footer",
        "blocks": [
          {
            "id": "blk_footer",
            "type": "footer",
            "props": {
              "logoText": "Northwind Studio",
              "copyrightText": "\u00a9 2026 Northwind Studio",
              "columns": [
                {
                  "id": "col_company",
                  "title": "Company",
                  "links": [
                    {
                      "id": "link_about",
                      "label": "About",
                      "target": {
                        "url": "/about"
                      }
                    },
                    {
                      "id": "link_contact",
                      "label": "Contact",
                      "target": {
                        "url": "/contact"
                      }
                    }
                  ]
                }
              ]
            },
            "styles": {
              "backgroundColor": "#FAF3EF",
              "textColor": "#1E1B19"
            }
          }
        ]
      }
    ]
  },
  "tokens": {
    "colorBackground": "#FAF3EF",
    "colorSurface": "#FFFFFF",
    "colorText": "#1E1B19",
    "colorTextMuted": "#6E625D",
    "colorPrimary": "#A43A2B",
    "colorPrimaryContrast": "#FFFFFF",
    "colorAccent": "#0F766E",
    "colorBorder": "#E9E2DE",
    "fontHeading": "Inter, system-ui, sans-serif",
    "fontBody": "Inter, system-ui, sans-serif",
    "radiusSm": "0.375rem",
    "radiusMd": "0.5rem",
    "radiusLg": "0.75rem",
    "shadowCard": "0 1px 2px rgba(30, 27, 25, 0.08)",
    "spaceSection": "4rem"
  },
  "media": {}
}
