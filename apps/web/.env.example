# Storefront application configuration (declared before use; no inline fallbacks).
# The API origin that serves the anonymous storefront read contract.
API_URL="http://localhost:4000"
# Optional port for the release-gate Playwright projects (default 3003). Set a
# free port when another storefront is already served on 3003.
E2E_WEB_PORT="3003"
# Tenant host root: <tenant-label>.DOMAIN_ROOT is the only host shape the
# storefront will render. Empty disables tenant hosts locally.
DOMAIN_ROOT=""
# Reserved hosts that are never treated as a tenant (FR-109, FR-117).
MARKETING_HOST=""
OPERATOR_HOST=""
# Release E2E gates (T124, T125, T129). Playwright fails closed when any value
# is missing; these placeholders point at the local development stack.
# E2E_STOREFRONT_URL is a tenant host root; E2E_DASHBOARD_URL is the workspace origin.
E2E_STOREFRONT_URL="http://localhost:3003"
E2E_DASHBOARD_URL="http://localhost:3001"
# Playwright storage state for an authenticated tenant member. Generate it from
# the release environment's dedicated test tenant, for example:
# pnpm --filter @suite/web exec playwright codegen --save-storage=tests/e2e/.auth/state.json "$E2E_DASHBOARD_URL"
E2E_DASHBOARD_STORAGE_STATE="tests/e2e/.auth/state.json"
E2E_SITE_ID=""
E2E_PAGE_ID=""
