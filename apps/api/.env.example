# Platform Core API Environment Configuration Template
PORT=4000
DATABASE_URL="postgresql://businessos_admin:businessos_password@localhost:5432/business_os_dev"
# Direct migration-owner connection used by migrations and Platform test fixtures
DIRECT_URL="postgresql://businessos_admin:businessos_password@localhost:5432/business_os_dev"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"
APP_VERSION="0.0.1"
GIT_COMMIT_SHA="dev"
BUILD_TIMESTAMP="2026-10-22T00:00:00Z"
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="CHANGE_ME_BETTER_AUTH_SECRET"
BETTER_AUTH_URL="http://localhost:3001"
API_URL="http://localhost:4000"
DASHBOARD_URL="http://localhost:3001"
ENABLE_INTERNAL_DOCS="true"
# Comma-separated proxy IPs whose forwarded headers may be trusted
TRUSTED_PROXY_IPS=""
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
# Generate with: openssl rand -hex 32
METRICS_AUTH_TOKEN="CHANGE_ME_METRICS_AUTH_TOKEN"
LOG_LEVEL="debug"
# Generate with: openssl rand -hex 32
GDPR_HMAC_SALT_KEY="CHANGE_ME_GDPR_HMAC_SALT_KEY"
R2_PUBLIC_URL="http://localhost:3001/uploads"

# ==============================================================================
# Shared Media Library (@suite/media)
# Required by every media request. No inline fallback: a missing key fails
# loudly instead of issuing an unsigned or placeholder URL.
# ==============================================================================
MEDIA_BUCKET="business-os-media"
MEDIA_S3_ENDPOINT="http://localhost:9000"
MEDIA_S3_REGION="auto"
MEDIA_S3_ACCESS_KEY_ID="CHANGE_ME_MEDIA_ACCESS_KEY_ID"
MEDIA_S3_SECRET_ACCESS_KEY="CHANGE_ME_MEDIA_SECRET_ACCESS_KEY"
MEDIA_PUBLIC_BASE_URL="http://localhost:9000/business-os-media"
MEDIA_MAX_BYTES="10485760"
MEDIA_URL_TTL_SECONDS="900"
# Where the object SHA-256 is enforced: "provider" (S3/MinIO) or "metadata"
# (Cloudflare R2, whose S3 API has no full-object SHA-256). Defaults to
# "provider" when unset. R2 setup and its trade-off are in the runbook.
MEDIA_S3_CHECKSUM_MODE="provider"

# ==============================================================================
# Platform — Operator Control Plane (server-side only)
# ==============================================================================
CONTROL_PLANE_ORIGIN="http://localhost:3002"
CONTROL_WEBAUTHN_RP_ID="localhost"
CONTROL_SESSION_SECRET="CHANGE_ME_CONTROL_SESSION_SECRET"
# app_platform runtime identity; never the tenant identity and never the migration owner
PLATFORM_DATABASE_URL="postgresql://app_platform:app_platform_password@localhost:5432/business_os_dev"
# app_tenant runtime identity; used by the DB-2 boundary test and the future tenant switch (T167)
TENANT_DATABASE_URL="postgresql://app_tenant:app_tenant_password@localhost:5432/business_os_dev"
EDGE_TEAM_DOMAIN="business-os.cloudflareaccess.com"
EDGE_AUDIENCE="platform-operator"
# Enforce the Cloudflare Access assertion at the API origin (production always enforces).
EDGE_ADMISSION_ENFORCED="false"
IMPERSONATION_MAX_MINUTES="30"
QUOTA_CACHE_TTL_SECONDS="60"
CATALOG_CACHE_TTL_SECONDS="60"
PLATFORM_BOOTSTRAP_OPERATOR_EMAIL="ops@example.com"
# Optional: the Platform dashboard build identity reported by /system/health.
# Set both or neither (FR-034).
PLATFORM_BUILD_ID=""
PLATFORM_BUILD_TIMESTAMP=""
# Optional: external error-tracking console linked from the System screen
# (FR-036) and served by /system/health. Must be an absolute http(s) URL; leave
# empty to render a "not configured" state instead of a link.
PLATFORM_ERROR_TRACKING_URL=""


# Authentication cookie policy across all apps: strict (default), lax, or none.
# Use none only for a genuinely cross-site HTTPS deployment.
SESSION_COOKIE_SAME_SITE="strict"

# ==============================================================================
# Abuse controls (FR-131 to FR-137)
# ==============================================================================
ABUSE_CONTACT_EMAIL="abuse@example.com"
ABUSE_PAGE_URL="http://localhost:3002/abuse"
# Optional local threat-reputation feed (JSON, maintained by operations).
ABUSE_REPUTATION_FEED_PATH=""
