# Platform Core API Environment Configuration Template
PORT=4000
DATABASE_URL="postgresql://businessos_admin:businessos_password@localhost:5432/business_os_dev"
# Direct migration-owner connection used by migrations and Platform test fixtures
DIRECT_URL="postgresql://businessos_admin:businessos_password@localhost:5432/business_os_dev"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="CHANGE_ME_BETTER_AUTH_SECRET"
BETTER_AUTH_URL="http://localhost:3001"
API_URL="http://localhost:4000"
DASHBOARD_URL="http://localhost:3001"
ENABLE_INTERNAL_DOCS="true"
# Comma-separated proxy IPs whose forwarded headers may be trusted
TRUSTED_PROXY_IPS=""
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
# Generate with: openssl rand -hex 32
METRICS_AUTH_TOKEN="CHANGE_ME_METRICS_AUTH_TOKEN"
LOG_LEVEL="debug"
# Generate with: openssl rand -hex 32
GDPR_HMAC_SALT_KEY="CHANGE_ME_GDPR_HMAC_SALT_KEY"
R2_PUBLIC_URL="http://localhost:3001/uploads"

# ==============================================================================
# Platform — Operator Control Plane (server-side only)
# ==============================================================================
CONTROL_PLANE_ORIGIN="http://localhost:3002"
CONTROL_WEBAUTHN_RP_ID="localhost"
CONTROL_SESSION_SECRET="CHANGE_ME_CONTROL_SESSION_SECRET"
# app_platform runtime identity; never the tenant identity and never the migration owner
PLATFORM_DATABASE_URL="postgresql://app_platform:app_platform_password@localhost:5432/business_os_dev"
# app_tenant runtime identity; used by the DB-2 boundary test and the future tenant switch (T167)
TENANT_DATABASE_URL="postgresql://app_tenant:app_tenant_password@localhost:5432/business_os_dev"
EDGE_TEAM_DOMAIN="business-os.cloudflareaccess.com"
EDGE_AUDIENCE="platform-operator"
IMPERSONATION_MAX_MINUTES="30"
QUOTA_CACHE_TTL_SECONDS="60"
CATALOG_CACHE_TTL_SECONDS="60"
PLATFORM_BOOTSTRAP_OPERATOR_EMAIL="ops@example.com"


# Authentication cookie policy across all apps: strict (default), lax, or none.
# Use none only for a genuinely cross-site HTTPS deployment.
SESSION_COOKIE_SAME_SITE="strict"
