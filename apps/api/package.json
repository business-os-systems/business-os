{
  "name": "@suite/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.reporter=lcov"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/zod-openapi": "^0.18.4",
    "@scalar/hono-api-reference": "^0.5.161",
    "@sentry/node": "^11.8.0",
    "@simplewebauthn/server": "14.0.3",
    "@suite/auth": "workspace:*",
    "@suite/core": "workspace:*",
    "@suite/db": "workspace:*",
    "@suite/flags": "workspace:*",
    "@suite/logger": "workspace:*",
    "@suite/redis": "workspace:*",
    "@suite/website-builder": "workspace:*",
    "dotenv": "^18.0.9",
    "hono": "^4.7.0",
    "jose": "^6.2.12",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@suite/tsconfig": "workspace:*",
    "@types/node": "^20.17.19",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
