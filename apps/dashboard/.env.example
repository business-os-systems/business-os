# Next.js Dashboard Environment Configuration Template
DATABASE_URL="postgresql://businessos_admin:businessos_password@localhost:5432/business_os_dev"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="CHANGE_ME_BETTER_AUTH_SECRET"
BETTER_AUTH_URL="http://localhost:3001"
API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Tenant host root: <tenant-label>.DOMAIN_ROOT is the tenant host that serves
# the published site at / and this workspace under /dashboard. Also widens
# serverActions.allowedOrigins. Leave empty to disable tenant hosts locally.
DOMAIN_ROOT=""
# Reserved marketing and operator hosts (FR-109, FR-117). Storefront routing
# never treats either as a tenant.
MARKETING_HOST=""
OPERATOR_HOST=""
APP_VERSION="0.0.1"
GIT_COMMIT_SHA="dev"
BUILD_TIMESTAMP="2026-10-22T00:00:00Z"

# Cloudflare Turnstile Bot Defense (Testing keys)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Third-Party Federated OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Support address shown to a suspended or archived workspace (optional)
SUPPORT_CONTACT_EMAIL=""

# Transactional Email Dispatch ("console" | "resend")
EMAIL_PROVIDER="console"
RESEND_API_KEY=""

# Tenant sessions are always host-only (__Host- prefix, no Domain attribute);
# a shared parent-domain cookie is not a supported configuration (FR-111).