# ==============================================================================
# Business OS — Universal Enterprise Composable Environment Configuration
# ==============================================================================

# Database Connection URL (PostgreSQL 16)
# Use connection_limit=10 to manage connection pool allocation across container replicas
DATABASE_URL="postgresql://businessos_admin:businessos_password@localhost:5432/business_os_dev?connection_limit=10&pool_timeout=20"
# Direct connection for Prisma migrations (bypassing connection poolers in production)
DIRECT_URL="postgresql://businessos_admin:businessos_password@localhost:5432/business_os_dev"

# Redis Cache & Lock Connection URL (Redis 7)
REDIS_URL="redis://localhost:6379"

# Node Environment ("development" | "test" | "production")
NODE_ENV="development"

# Authentication & Cryptographic Session Security
# Required for signing and verifying HMAC-SHA256 user sessions & manager overrides (min 32 characters)
BETTER_AUTH_SECRET="business-os-enterprise-session-signing-secret-key-32ch-min"
BETTER_AUTH_URL="http://localhost:3001"

# API & Backend Services
PORT=4000
API_URL="http://localhost:4000"
DASHBOARD_URL="http://localhost:3001"
ENABLE_INTERNAL_DOCS="true"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
METRICS_AUTH_TOKEN="metrics-secure-telemetry-token-dev"

# ==============================================================================
# Platform — Operator Control Plane
# ==============================================================================
# Canonical operator origin (apps/platform runs on 3002 in development)
CONTROL_PLANE_ORIGIN="http://localhost:3002"
# WebAuthn relying-party identity: domain only, no scheme and no port
CONTROL_WEBAUTHN_RP_ID="localhost"
# Signs control-plane-only sessions; minimum 32 characters
CONTROL_SESSION_SECRET="platform-control-session-signing-secret-32ch-min"
# app_platform runtime identity; never the tenant identity and never the migration owner
PLATFORM_DATABASE_URL="postgresql://app_platform:app_platform_password@localhost:5432/business_os_dev"
# Identity-aware edge gate (Cloudflare Access)
EDGE_TEAM_DOMAIN="business-os.cloudflareaccess.com"
EDGE_AUDIENCE="platform-operator"
# Support-session duration and cache bounds (seconds unless stated)
IMPERSONATION_MAX_MINUTES="30"
QUOTA_CACHE_TTL_SECONDS="60"
CATALOG_CACHE_TTL_SECONDS="60"
# Used once by the offline bootstrap command
PLATFORM_BOOTSTRAP_OPERATOR_EMAIL="ops@example.com"

# Frontend Dashboard Networking
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Root domain for per-tenant dashboard origins in serverActions.allowedOrigins
# (e.g. "rohitbahuguna.online"). Leave empty for local development.
DOMAIN_ROOT=""

# Observability & Logging ("debug" | "info" | "warn" | "error")
LOG_LEVEL="debug"
SERVICE_NAME="business-os"
APP_VERSION="0.0.1"
GIT_COMMIT_SHA="dev"
BUILD_TIMESTAMP="2026-10-22T00:00:00Z"

# Sentry Crash Reporting (Cloud Free Tier or self-hosted DSN)
# When left empty, Sentry initialization gracefully disables without throwing
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Data Privacy & Module Security
GDPR_HMAC_SALT_KEY="business_os_gdpr_salt_secret_key_prod_safe"
R2_PUBLIC_URL="http://localhost:3001/uploads"

# Cloudflare Turnstile Bot Defense (Testing keys: always passes challenge)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Note: Frontend OAuth credentials (GOOGLE_*, GITHUB_*, MICROSOFT_*) are configured in apps/dashboard/.env.local

# Transactional Email Dispatch ("console" | "resend")
EMAIL_PROVIDER="console"
RESEND_API_KEY=""

# Optional Session Lifecycle Overrides (in seconds; ephemeral: 24h, persistent: 30d)
# SESSION_EPHEMERAL_MAX_AGE_SECONDS=86400
# SESSION_PERSISTENT_MAX_AGE_SECONDS=2592000

# Optional Parent Cookie Domain for unified multi-subdomain session continuity (e.g. ".rohitbahuguna.online")
# When omitted or running on localhost, cookies remain strictly host-only.
SESSION_COOKIE_DOMAIN=""
