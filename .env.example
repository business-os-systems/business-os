# ==============================================================================
# Business OS — Universal Enterprise Composable Environment Configuration
# ==============================================================================

# Database Connection URL (PostgreSQL 16)
# Use connection_limit=10 to manage connection pool allocation across container replicas
DATABASE_URL="postgresql://businessos_admin:businessos_password@localhost:5432/business_os_dev?connection_limit=10&pool_timeout=20"
# Direct connection for Prisma migrations (bypassing connection poolers in production)
DIRECT_URL="postgresql://businessos_admin:businessos_password@localhost:5432/business_os_dev"

# Redis Cache & Lock Connection URL (Redis 7)
REDIS_URL="redis://localhost:6379"

# Node Environment ("development" | "test" | "production")
NODE_ENV="development"

# Authentication & Cryptographic Session Security
# Required for signing and verifying HMAC-SHA256 user sessions & manager overrides (min 32 characters)
BETTER_AUTH_SECRET="business-os-enterprise-session-signing-secret-key-32ch-min"
BETTER_AUTH_URL="http://localhost:3001"

# API & Backend Services
PORT=4000
API_URL="http://localhost:4000"
DASHBOARD_URL="http://localhost:3001"
ENABLE_INTERNAL_DOCS="true"

# Frontend Dashboard Networking
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Observability & Logging ("debug" | "info" | "warn" | "error")
LOG_LEVEL="debug"
SERVICE_NAME="business-os"

# Data Privacy & Module Security
GDPR_HMAC_SALT_KEY="business_os_gdpr_salt_secret_key_prod_safe"
R2_PUBLIC_URL="http://localhost:3001/uploads"

# Cloudflare Turnstile Bot Defense (Testing keys: always passes challenge)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Note: Frontend OAuth credentials (GOOGLE_*, GITHUB_*, MICROSOFT_*) are configured in apps/dashboard/.env.local

# Transactional Email Dispatch ("console" | "resend")
EMAIL_PROVIDER="console"
RESEND_API_KEY=""

# Optional Session Lifecycle Overrides (in seconds; ephemeral: 24h, persistent: 30d)
# SESSION_EPHEMERAL_MAX_AGE_SECONDS=86400
# SESSION_PERSISTENT_MAX_AGE_SECONDS=2592000
