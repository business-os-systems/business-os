// ==============================================================================
// APP 01: WEBSITE BUILDER & HEADLESS CMS (@suite/website-builder)
//
// One schema for the whole application (DB-3). Every table keeps its mandatory
// cms_ prefix and lives in the dedicated PostgreSQL "cms" schema declared in
// base.prisma; the 20261111140000 migration moves the legacy public.cms_*
// tables across and owns the grants and RLS for this schema.
//
// Site, page, collection and content models are the tenant plane: tenancy is
// the scalar organizationId column only, so no reverse relation is added to a
// core model and no foreign key crosses the cms boundary (XV.3). Themes,
// templates, section templates and catalog items are hybrid: a NULL
// organizationId is a platform-global row that every tenant may read, while
// writes stay inside the current tenant.
//
// The partial unique index that keeps exactly one home page per site is
// declared in SQL (Prisma cannot express partial indexes):
// cms_pages_one_home_page_per_site_key.
// ==============================================================================

enum CmsSiteStatus {
  DRAFT
  PUBLISHED
  MAINTENANCE
  SUSPENDED
  ARCHIVED

  @@schema("cms")
}

enum CmsDomainStatus {
  PENDING_VERIFICATION
  ACTIVE
  ERROR
  DELETED

  @@schema("cms")
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED

  @@schema("cms")
}

enum CmsLocaleStatus {
  ACTIVE
  INACTIVE

  @@schema("cms")
}

enum CmsInquiryStatus {
  NEW
  READ
  ARCHIVED
  SPAM

  @@schema("cms")
}

enum CmsRedirectType {
  PERMANENT // 301
  TEMPORARY // 302

  @@schema("cms")
}

model CmsSite {
  id              String         @id @default(cuid())
  organizationId  String         // Tenant boundary scalar (no reverse model coupling)
  branchId        String?        // Operational branch scalar (no reverse model coupling)

  title           String         @db.VarChar(191)
  slug            String         @db.VarChar(191)
  // The client request id that first provisioned this site. It makes
  // create-from-template idempotent (CT-4) without a second ledger table.
  idempotencyKey  String?        @db.VarChar(128)
  status          CmsSiteStatus  @default(DRAFT)
  timezone        String         @default("Asia/Kolkata") @db.VarChar(64)
  primaryLocale   String         @default("en") @db.VarChar(10)

  // Design system token linkage
  themeId         String?
  theme           CmsTheme?      @relation(fields: [themeId], references: [id], onDelete: SetNull)

  // Lifecycle retention (FR-097): an inactive site is flagged for deletion and
  // stays intact until an authorised operator explicitly confirms removal. No
  // timer may ever delete site content; the confirmation records who approved it.
  deletionFlaggedAt   DateTime?  @db.Timestamptz(6)
  deletionConfirmedAt DateTime?  @db.Timestamptz(6)
  deletionConfirmedBy String?    @db.VarChar(191)

  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  // Relational Modules within CMS boundary
  settings        CmsSiteSettings?
  appearance      CmsSiteAppearance?
  seoSettings     CmsSiteSeoSettings?
  domains         CmsDomain[]
  pages           CmsPage[]
  collections     CmsCollection[]
  locales         CmsSiteLocale[]
  redirects       CmsUrlRedirect[]
  inquiries       CmsInquiry[]
  plugins         CmsPluginInstallation[]
  navigationMenus CmsNavigationMenu[]
  analyticsDaily  CmsSiteAnalyticsDaily[]
  auditTrails     CmsAuditTrail[]

  @@unique([organizationId, slug])
  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId]) // Target for composite foreign keys
  @@index([organizationId, status])
  @@index([deletionFlaggedAt])
  @@index([branchId])
  @@map("cms_sites")

  @@schema("cms")
}

model CmsSiteSettings {
  id              String       @id @default(cuid())
  organizationId  String
  siteId          String       @unique
  site            CmsSite      @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  faviconUrl      String?      @db.Text
  brandLogoUrl    String?      @db.Text
  brandName       String?      @db.VarChar(191)
  headerAst       Json         @default("{}") // Global site navigation AST
  footerAst       Json         @default("{}") // Global site footer AST
  customCss       String?      @db.Text
  customHeadCode  String?      @db.Text

  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([siteId, organizationId])
  @@index([organizationId, siteId])
  @@map("cms_site_settings")

  @@schema("cms")
}

// One complete appearance snapshot per site, owned by the tenant. Selecting a
// catalog theme copies its token values into this row; the catalog is never
// read at render time, so a later platform theme change cannot restyle an
// existing site (FR-150..FR-157). Draft and published snapshots are separate
// and every mutation is guarded by concurrencyVersion (CT-3).
model CmsSiteAppearance {
  id                 String   @id @default(cuid())
  organizationId     String
  siteId             String   @unique
  site               CmsSite  @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // Working snapshot edited by the appearance panel.
  draftTokens        Json
  // Visitor-facing snapshot; only a publish copies draft into it.
  publishedTokens    Json
  // Snapshot copied when the theme was selected; reset restores these values.
  sourceTokens       Json

  sourceItemId       String?  @db.VarChar(64)
  sourceVersion      Int?
  concurrencyVersion Int      @default(1)
  publishedAt        DateTime @default(now()) @db.Timestamptz(6)

  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  @@unique([siteId, organizationId])
  @@index([organizationId, siteId])
  @@map("cms_site_appearances")

  @@schema("cms")
}

model CmsDomain {
  id                 String           @id @default(cuid())
  organizationId     String
  siteId             String
  site               CmsSite          @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  hostname           String           @unique @db.VarChar(255) // e.g. "stay.riverview.com" or "riverview.business-os.site"
  isPrimary          Boolean          @default(false)
  isSubdomain        Boolean          @default(false) // true for *.business-os.site
  status             CmsDomainStatus  @default(PENDING_VERIFICATION)
  verificationToken  String           @db.VarChar(64) // _businessos-challenge
  sslActive          Boolean          @default(false)
  verifiedAt         DateTime?        @db.Timestamptz(6)

  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  @@index([organizationId, siteId])
  @@index([hostname, status])
  @@map("cms_domains")

  @@schema("cms")
}

model CmsPage {
  id              String         @id @default(cuid())
  organizationId  String
  siteId          String
  site            CmsSite        @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  parentId        String?
  parentPage      CmsPage?       @relation("CmsPageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  childPages      CmsPage[]      @relation("CmsPageHierarchy")

  title           String         @db.VarChar(191)
  slug            String         @db.VarChar(191) // "/rooms", "/about-us"
  orderIndex      Int            @default(0)
  status          CmsPageStatus  @default(DRAFT)
  isHomePage      Boolean        @default(false)

  // System Design: CAS Concurrency Revision
  revision        Int            @default(1)

  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  content         CmsPageContent?
  versions        CmsPageVersion[]
  translations    CmsPageTranslation[]
  comments        CmsPageComment[]

  @@unique([siteId, slug])
  @@unique([id, organizationId]) // Target for composite foreign keys
  @@index([organizationId, siteId])
  @@index([siteId, status])
  @@index([parentId])
  @@map("cms_pages")

  @@schema("cms")
}

model CmsPageContent {
  id              String      @id @default(cuid())
  organizationId  String
  pageId          String      @unique
  page            CmsPage     @relation(fields: [pageId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // Dual-Track Content Isolation Pattern
  draftAst        Json        @default("{}") // Live authoring state
  publishedAst    Json?       // Edge CDN storefront production state
  publishedAt     DateTime?   @db.Timestamptz(6)

  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)

  @@unique([pageId, organizationId])
  @@index([organizationId, pageId])
  @@map("cms_page_contents")

  @@schema("cms")
}

model CmsPageVersion {
  id              String      @id @default(cuid())
  organizationId  String
  pageId          String
  page            CmsPage     @relation(fields: [pageId, organizationId], references: [id, organizationId], onDelete: Cascade)

  versionNumber   Int
  astSnapshot     Json        // Immutable snapshot of published AST
  label           String?     @db.VarChar(100) // e.g. "Holiday Sale 2026 Release"
  createdByUserId String?     @db.VarChar(191)

  createdAt       DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([pageId, versionNumber])
  @@index([organizationId, pageId])
  @@map("cms_page_versions")

  @@schema("cms")
}

model CmsPageComment {
  id              String           @id @default(cuid())
  organizationId  String
  pageId          String
  page            CmsPage          @relation(fields: [pageId, organizationId], references: [id, organizationId], onDelete: Cascade)

  parentId        String?
  parentComment   CmsPageComment?  @relation("CmsCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         CmsPageComment[] @relation("CmsCommentReplies")

  blockId         String?          @db.VarChar(64) // Targeted block UUID in the AST
  coordX          Decimal?         @db.Decimal(5, 2) // Canvas % x-coordinate
  coordY          Decimal?         @db.Decimal(5, 2) // Canvas % y-coordinate
  commentText     String           @db.Text
  authorUserId    String           @db.VarChar(191)
  resolved        Boolean          @default(false)

  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  @@index([organizationId, pageId])
  @@index([parentId])
  @@map("cms_page_comments")

  @@schema("cms")
}

model CmsCollection {
  id              String              @id @default(cuid())
  organizationId  String
  siteId          String
  site            CmsSite             @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  name            String              @db.VarChar(191) // "Rooms", "Menu Items", "Blog Posts"
  slug            String              @db.VarChar(191) // "rooms", "menu-items"
  schemaJson      Json                // Dynamic Zod/JSON schema defining content fields

  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)

  items           CmsCollectionItem[]

  @@unique([siteId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, siteId])
  @@map("cms_collections")

  @@schema("cms")
}

model CmsCollectionItem {
  id              String         @id @default(cuid())
  organizationId  String
  collectionId    String
  collection      CmsCollection  @relation(fields: [collectionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  slug            String         @db.VarChar(191)
  dataJson        Json           // Structured content validated against collection.schemaJson
  revision        Int            @default(1)
  isPublished     Boolean        @default(false)

  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  @@unique([collectionId, slug])
  @@index([organizationId, collectionId])
  @@map("cms_collection_items")

  @@schema("cms")
}

model CmsTheme {
  id              String       @id @default(cuid())
  organizationId  String?      // NULL for platform global themes, set for custom tenant brand themes
  name            String       @db.VarChar(191)
  code            String       @unique @db.VarChar(64)
  tokens          Json         // Design system tokens: fonts, colors, radii, shadows

  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  sites           CmsSite[]

  @@index([organizationId])
  @@map("cms_themes")

  @@schema("cms")
}

model CmsTemplate {
  id              String       @id @default(cuid())
  organizationId  String?      // NULL for platform global templates
  name            String       @db.VarChar(191)
  category        String       @db.VarChar(64) // "hospitality", "restaurant", "retail", "services"
  previewImageUrl String?      @db.Text
  blueprintJson   Json         // Turnkey multi-page site structure and sample content

  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  @@index([organizationId, category])
  @@map("cms_templates")

  @@schema("cms")
}

model CmsSectionTemplate {
  id              String       @id @default(cuid())
  organizationId  String?      // NULL for platform global block presets
  name            String       @db.VarChar(191)
  category        String       @db.VarChar(64) // "hero", "features", "pricing", "testimonials", "faq"
  blockAst        Json         // Reusable block subtree

  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  @@index([organizationId, category])
  @@map("cms_section_templates")

  @@schema("cms")
}

model CmsSiteSeoSettings {
  id               String      @id @default(cuid())
  organizationId   String
  siteId           String      @unique
  site             CmsSite     @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  metaTitle        String?     @db.VarChar(191)
  metaDescription  String?     @db.Text
  ogImageUrl       String?     @db.Text
  robotsTxt        String?     @db.Text
  enableLlmsTxt    Boolean     @default(true) // Generative Engine Optimization (GEO)
  customStructuredData Json?   // Schema.org JSON-LD

  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)

  @@unique([siteId, organizationId])
  @@index([organizationId, siteId])
  @@map("cms_site_seo_settings")

  @@schema("cms")
}

model CmsSiteLocale {
  id              String           @id @default(cuid())
  organizationId  String
  siteId          String
  site            CmsSite          @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  locale          String           @db.VarChar(10) // "fr", "hi", "es"
  displayName     String           @db.VarChar(64) // "Français", "हिंदी"
  status          CmsLocaleStatus  @default(ACTIVE)

  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([siteId, locale])
  @@index([organizationId, siteId])
  @@map("cms_site_locales")

  @@schema("cms")
}

model CmsPageTranslation {
  id              String       @id @default(cuid())
  organizationId  String
  pageId          String
  page            CmsPage      @relation(fields: [pageId, organizationId], references: [id, organizationId], onDelete: Cascade)

  locale          String       @db.VarChar(10)
  title           String       @db.VarChar(191)
  translatedAst   Json

  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([pageId, locale])
  @@index([organizationId, pageId])
  @@map("cms_page_translations")

  @@schema("cms")
}

model CmsUrlRedirect {
  id              String           @id @default(cuid())
  organizationId  String
  siteId          String
  site            CmsSite          @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  sourcePath      String           @db.VarChar(255) // "/old-rates"
  targetUrl       String           @db.Text         // "/pricing"
  type            CmsRedirectType  @default(PERMANENT)

  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  @@unique([siteId, sourcePath])
  @@index([organizationId, siteId])
  @@map("cms_url_redirects")

  @@schema("cms")
}

model CmsInquiry {
  id                 String            @id @default(cuid())
  organizationId     String
  siteId             String
  site               CmsSite           @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  pageId             String?           @db.VarChar(64) // Page whose published AST contains the form block
  blockId            String            @db.VarChar(100) // Form block id in the published AST
  idempotencyKey     String            @db.VarChar(128) // Idempotency-Key header
  payloadJson        Json              // Submitted field values (contact fields gated on read)
  attachments        Json              @default("[]") // Quarantined attachment references
  status             CmsInquiryStatus  @default(NEW)
  // Why a submission was quarantined. Recorded, never revealed to the visitor (FR-046).
  spamVerdict        String?           @db.VarChar(32)

  // GDPR & anti-PII compliance: salted one-way hashes only, never raw contact data.
  submitterHash      String?           @db.VarChar(64) // HMAC of network identity
  emailHash          String?           @db.VarChar(64) // HMAC of the submitted email

  readAt             DateTime?         @db.Timestamptz(6)
  archivedAt         DateTime?         @db.Timestamptz(6)
  // Declared retention: a row is purged after 365 days unless erased sooner (FR-049).
  retentionExpiresAt DateTime          @default(dbgenerated("(now() + interval '365 days')")) @db.Timestamptz(6)

  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  events             CmsInquiryEvent[]

  @@unique([siteId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, siteId, status, createdAt])
  @@index([organizationId, status])
  @@index([emailHash])
  @@index([organizationId, retentionExpiresAt])
  @@map("cms_inquiries")

  @@schema("cms")
}

// Append-only domain event for a captured inquiry (FR-140). Release one stages
// the event so a later shared notification capability can subscribe; nothing
// dispatches it now (FR-138).
model CmsInquiryEvent {
  id             String     @id @default(cuid())
  organizationId String
  siteId         String
  inquiryId      String
  inquiry        CmsInquiry @relation(fields: [inquiryId, organizationId], references: [id, organizationId], onDelete: Cascade)

  eventType      String     @db.VarChar(64)
  payloadJson    Json

  createdAt      DateTime   @default(now()) @db.Timestamptz(6)

  @@unique([inquiryId, eventType])
  @@index([organizationId, eventType, createdAt])
  @@map("cms_inquiry_events")

  @@schema("cms")
}

model CmsSiteAnalyticsDaily {
  id              String       @id @default(cuid())
  organizationId  String
  siteId          String
  site            CmsSite      @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  date            DateTime     @db.Date
  totalVisits     Int          @default(0)
  uniqueVisitors  Int          @default(0)
  bounceRate      Decimal      @default(0.0) @db.Decimal(5, 2)
  topPaths        Json         @default("[]") // [{ path: "/", count: 120 }]

  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([siteId, date])
  @@index([organizationId, siteId, date])
  @@map("cms_site_analytics_daily")

  @@schema("cms")
}

model CmsPluginInstallation {
  id              String       @id @default(cuid())
  organizationId  String
  siteId          String
  site            CmsSite      @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  pluginId        String       @db.VarChar(64) // "mailchimp", "whatsapp_chat", "google_analytics"
  enabled         Boolean      @default(true)
  encryptedConfig String       @db.Text        // AES-256-GCM encrypted credentials with tenant AAD
  iv              String       @db.VarChar(32) // 96-bit AES-GCM IV
  tag             String       @db.VarChar(32) // 128-bit authentication tag

  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([siteId, pluginId])
  @@index([organizationId, siteId])
  @@map("cms_plugin_installations")

  @@schema("cms")
}

model CmsNavigationMenu {
  id              String       @id @default(cuid())
  organizationId  String
  siteId          String
  site            CmsSite      @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  name            String       @db.VarChar(191) // "Header Nav", "Footer Secondary"
  handle          String       @db.VarChar(64)  // "primary", "footer"
  itemsAst        Json         // Menu links, dropdowns, and target URLs

  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([siteId, handle])
  @@index([organizationId, siteId])
  @@map("cms_navigation_menus")

  @@schema("cms")
}

model CmsAuditTrail {
  id              String       @id @default(cuid())
  organizationId  String
  siteId          String
  site            CmsSite      @relation(fields: [siteId, organizationId], references: [id, organizationId], onDelete: Cascade)

  action          String       @db.VarChar(64) // "PAGE_PUBLISHED", "THEME_UPDATED", "DOMAIN_LINKED"
  entityType      String       @db.VarChar(64) // "CmsPage", "CmsSite", "CmsDomain"
  entityId        String       @db.VarChar(64)
  actorUserId     String       @db.VarChar(191)
  changesJson     Json?

  createdAt       DateTime     @default(now()) @db.Timestamptz(6)

  @@index([organizationId, siteId, createdAt])
  @@map("cms_audit_trails")

  @@schema("cms")
}

// Application catalog: versioned sections, templates and themes. The catalog
// is platform-administered; a tenant reads global rows and its own tenant rows.
enum CmsCatalogKind {
  SECTION
  TEMPLATE
  THEME

  @@schema("cms")
}

enum CmsCatalogScope {
  GLOBAL
  TENANT

  @@schema("cms")
}

enum CmsCatalogStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  DISABLED
  RETIRED

  @@schema("cms")
}

// The item row carries the working definition and the lifecycle. Published
// history lives in CmsCatalogItemVersion and is immutable.
model CmsCatalogItem {
  id                 String           @id @default(cuid())
  kind               CmsCatalogKind
  scope              CmsCatalogScope  @default(GLOBAL)
  // Tenant-scoped catalog rows are release two; global rows have no tenant.
  organizationId     String?
  name               String           @db.VarChar(191)
  slug               String           @db.VarChar(191)
  category           String           @db.VarChar(64)
  industries         String[]         @default([])
  // Working draft (and the published definition after a publish).
  definition         Json
  previewRef         String?          @db.Text
  flagKey            String?          @db.VarChar(64)
  targeting          Json             @default("{}")
  status             CmsCatalogStatus @default(DRAFT)
  // Declared contract version of the definition payload (FR-070).
  contractVersion    String           @default("2026-03") @db.VarChar(32)
  // Latest published version. Zero until the first publish.
  currentVersion     Int              @default(0)
  // The pending draft version number, null when no draft exists.
  draftVersion       Int?
  // Optimistic concurrency token for draft and lifecycle writes (CT-3).
  concurrencyVersion Int              @default(1)
  // Preview evidence for the current draft (FR-006, FR-149).
  previewedAt        DateTime?        @db.Timestamptz(6)
  previewedHash      String?          @db.VarChar(64)
  previewedBy        String?          @db.VarChar(191)
  publishedAt        DateTime?        @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)
  createdBy          String           @db.VarChar(191)
  updatedBy          String           @db.VarChar(191)

  versions CmsCatalogItemVersion[]

  @@unique([kind, scope, organizationId, slug])
  @@index([kind, status])
  @@index([scope, organizationId])
  @@index([updatedAt, id])
  @@map("cms_catalog_items")
  @@schema("cms")
}

// One immutable published snapshot per (itemId, version). A database trigger
// rejects every UPDATE so history can never be rewritten (FR-005, T011).
model CmsCatalogItemVersion {
  id              String           @id @default(cuid())
  itemId          String
  item            CmsCatalogItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  version         Int
  definition      Json
  status          CmsCatalogStatus @default(ACTIVE)
  contractVersion String           @default("2026-03") @db.VarChar(32)
  changeNote      String?          @db.VarChar(500)
  previewedAt     DateTime?        @db.Timestamptz(6)
  previewedHash   String?          @db.VarChar(64)
  previewedBy     String?          @db.VarChar(191)
  publishedAt     DateTime         @db.Timestamptz(6)
  publishedBy     String           @db.VarChar(191)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  createdBy       String           @db.VarChar(191)

  @@unique([itemId, version])
  @@index([itemId, status])
  @@map("cms_catalog_item_versions")
  @@schema("cms")
}
