{
  "name": "@suite/website-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "import": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "import": "./src/events/index.ts",
      "default": "./src/events/index.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "import": "./src/services/index.ts",
      "default": "./src/services/index.ts"
    },
    "./routes": {
      "types": "./src/routes/index.ts",
      "import": "./src/routes/index.ts",
      "default": "./src/routes/index.ts"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "import": "./src/db/index.ts",
      "default": "./src/db/index.ts"
    },
    "./editor": {
      "types": "./src/editor/index.ts",
      "import": "./src/editor/index.ts",
      "default": "./src/editor/index.ts"
    },
    "./ast": {
      "types": "./src/ast/index.ts",
      "import": "./src/ast/index.ts",
      "default": "./src/ast/index.ts"
    },
    "./render": {
      "types": "./src/render/index.ts",
      "import": "./src/render/index.ts",
      "default": "./src/render/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.reporter=lcov"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.4",
    "@suite/core": "workspace:*",
    "@suite/db": "workspace:*",
    "@suite/ui": "workspace:*",
    "hono": "^4.7.0",
    "isomorphic-dompurify": "^4.5.0",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@suite/tsconfig": "workspace:*",
    "@types/node": "^20.17.19",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
