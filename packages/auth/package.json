  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@suite/core": "workspace:*",
    "@suite/db": "workspace:*",
    "@suite/redis": "workspace:*",
    "better-auth": "^1.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@suite/eslint-config": "workspace:*",
    "@suite/tsconfig": "workspace:*",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^8.57.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
