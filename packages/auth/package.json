{
  "name": "@suite/auth",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pin": {
      "types": "./src/pin/index.ts",
      "import": "./src/pin/index.ts",
      "default": "./src/pin/index.ts"
    },
    "./sso": {
      "types": "./src/sso/index.ts",
      "import": "./src/sso/index.ts",
      "default": "./src/sso/index.ts"
    },
    "./session": {
      "types": "./src/session/index.ts",
      "import": "./src/session/index.ts",
      "default": "./src/session/index.ts"
    },
    "./rules": {
      "types": "./src/password/password-rules.ts",
      "import": "./src/password/password-rules.ts",
      "default": "./src/password/password-rules.ts"
    },
    "./password": {
      "types": "./src/password/password-engine.ts",
