# ==============================================================================
# Business OS — Media library (@suite/media)
# Every key is required; there is no inline fallback. The API fails before it
# can presign or finalise an upload when one is missing.
# ==============================================================================
# The S3-compatible bucket that holds uploaded objects (Cloudflare R2 or S3).
MEDIA_BUCKET="business-os-media"
# S3-compatible endpoint; R2 uses https://<account-id>.r2.cloudflarestorage.com
MEDIA_S3_ENDPOINT="http://localhost:9000"
# Region value the provider expects; R2 accepts "auto".
MEDIA_S3_REGION="auto"
# Access key limited to the media bucket.
MEDIA_S3_ACCESS_KEY_ID="CHANGE_ME_MEDIA_ACCESS_KEY_ID"
MEDIA_S3_SECRET_ACCESS_KEY="CHANGE_ME_MEDIA_SECRET_ACCESS_KEY"
# Stable public delivery origin for stored objects (no trailing slash needed).
MEDIA_PUBLIC_BASE_URL="http://localhost:9000/business-os-media"
# Largest single upload accepted, in bytes (10 MiB).
MEDIA_MAX_BYTES="10485760"
# Presigned upload lifetime in seconds (S3 caps this at 604800).
MEDIA_URL_TTL_SECONDS="900"
