{
  "name": "@suite/flags",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.reporter=lcov"
  },
  "dependencies": {
    "@suite/db": "workspace:*",
    "@suite/logger": "workspace:*",
    "@suite/redis": "workspace:*",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@suite/tsconfig": "workspace:*",
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
