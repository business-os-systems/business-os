{
  "name": "@suite/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "import": "./src/errors/index.ts",
      "default": "./src/errors/index.ts"
    },
    "./clock": {
      "types": "./src/clock/index.ts",
      "import": "./src/clock/index.ts",
      "default": "./src/clock/index.ts"
    },
    "./rbac": {
      "types": "./src/rbac/index.ts",
      "import": "./src/rbac/index.ts",
      "default": "./src/rbac/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "import": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "import": "./src/constants/index.ts",
      "default": "./src/constants/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog/index.ts",
      "import": "./src/catalog/index.ts",
      "default": "./src/catalog/index.ts"
    },
    "./time": {
      "types": "./src/time/index.ts",
      "import": "./src/time/index.ts",
      "default": "./src/time/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@suite/tsconfig": "workspace:*",
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
