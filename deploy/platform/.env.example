# Deployment-host only. Never commit real credentials.
# Owner/migration identity; used to provision the runtime roles.
DATABASE_URL="postgresql://businessos_admin:change-me@postgres:5432/business_os_dev"
# Password for the owner/admin database user above.
POSTGRES_PASSWORD="replace-with-a-generated-secret"
# Generated secrets for the two runtime identities.
APP_PLATFORM_DB_PASSWORD="replace-with-a-generated-secret"
APP_TENANT_DB_PASSWORD="replace-with-a-generated-secret"

# Runtime identity checked by the deploy gate.
PLATFORM_DATABASE_URL="postgresql://app_platform:replace-with-a-generated-secret@postgres:5432/business_os_dev"
# Tenant runtime identity used by the DB-2 boundary check and required by the
# deploy preflight.
TENANT_DATABASE_URL="postgresql://app_tenant:replace-with-a-generated-secret@postgres:5432/business_os_dev"

# Comma-separated proxy IPs allowed to supply forwarded client-IP headers.
# Required in production: the API refuses to start with an empty list, because
# every client behind the proxy would otherwise share one rate-limit bucket.
TRUSTED_PROXY_IPS=""

# Authentication cookie policy across all apps: strict (default), lax, or none.
# Use none only for a genuinely cross-site HTTPS deployment.
SESSION_COOKIE_SAME_SITE="strict"

# ------------------------------------------------------------------------------
# Host model (FR-109, FR-117). The three host roles are distinct: one host per
# tenant under DOMAIN_ROOT, the reserved operator console, and the reserved
# marketing/account-entry host. The same names are read by the applications, so
# the values here must match the root .env; this file is sourced second, so it
# is the value the edge and the applications both see.
# ------------------------------------------------------------------------------
# Tenant host root: <tenant-label>.DOMAIN_ROOT serves the published site at /
# and the workspace under /dashboard. Never a scheme, port or trailing dot.
DOMAIN_ROOT="tenants.example.com"
# Reserved marketing and account-entry host. It is never treated as a tenant and
# never serves the workspace (see README, "Three-host model decision").
MARKETING_HOST="www.example.com"
# Canonical operator console host. CONTROL_PLANE_ORIGIN in the app env must be
# https://<OPERATOR_HOST> and CONTROL_WEBAUTHN_RP_ID must be <OPERATOR_HOST>.
OPERATOR_HOST="ops.example.com"

# ------------------------------------------------------------------------------
# Edge and break-glass (used by Caddyfile and docker-compose.yml)
# ------------------------------------------------------------------------------
# Separate recovery hostname. Caddy requires a client certificate on this host
# and overwrites X-Break-Glass-Verified before proxying to the application.
BREAK_GLASS_DOMAIN="break-glass.example.com"
ACME_EMAIL="ops@example.com"
# CA bundle that signs the offline break-glass client certificate. Mount the
# file into the caddy service at this path; never commit the private key.
BREAK_GLASS_CA_CERT_PATH="/etc/caddy/break-glass-ca.pem"
# Host directory holding the wildcard certificate for *.<DOMAIN_ROOT>
# (fullchain.pem and privkey.pem). Issued out of band with DNS-01 because a
# wildcard cannot complete an HTTP-01 challenge; Caddy mounts it read-only at
# /etc/caddy/tenant-tls. A deploy fails when the value or the pair is missing.
TENANT_TLS_DIR="/etc/business-os/tenant-tls"
# One real tenant host the post-deploy smoke check proves: / serves the
# storefront, /dashboard serves the workspace and /robots.txt is the storefront
# robots file. It must be one label under DOMAIN_ROOT and must resolve to a
# tenant that already has a published site.
SMOKE_TENANT_HOST="canary.tenants.example.com"

# The deployment env is the union of the root app .env.example (DATABASE_URL,
# REDIS_URL, API_URL, DASHBOARD_URL, CONTROL_*, media credentials, ...) and this
# file. API_URL must address the API over the compose network
# (http://api:4000). NEXT_PUBLIC_API_URL must be the canonical operator origin
# (https://<OPERATOR_HOST>) and is baked into the Platform build.
