# Deployment-host only. Never commit real credentials.
# Owner/migration identity; used to provision the runtime roles.
DATABASE_URL="postgresql://businessos_admin:change-me@postgres:5432/business_os_dev"
# Password for the owner/admin database user above.
POSTGRES_PASSWORD="replace-with-a-generated-secret"
# Generated secrets for the two runtime identities.
APP_PLATFORM_DB_PASSWORD="replace-with-a-generated-secret"
APP_TENANT_DB_PASSWORD="replace-with-a-generated-secret"

# Runtime identity checked by the deploy gate.
PLATFORM_DATABASE_URL="postgresql://app_platform:replace-with-a-generated-secret@postgres:5432/business_os_dev"
# Tenant runtime identity used by the DB-2 boundary check.
TENANT_DATABASE_URL="postgresql://app_tenant:replace-with-a-generated-secret@postgres:5432/business_os_dev"

# Comma-separated proxy IPs allowed to supply forwarded client-IP headers.
# Required in production: the API refuses to start with an empty list, because
# every client behind the proxy would otherwise share one rate-limit bucket.
TRUSTED_PROXY_IPS=""

# Authentication cookie policy across all apps: strict (default), lax, or none.
# Use none only for a genuinely cross-site HTTPS deployment.
SESSION_COOKIE_SAME_SITE="strict"

# ------------------------------------------------------------------------------
# Edge and break-glass (used by Caddyfile and docker-compose.yml)
# ------------------------------------------------------------------------------
# Canonical operator hostname. CONTROL_PLANE_ORIGIN in the app env must be
# https://<OPERATOR_DOMAIN> and CONTROL_WEBAUTHN_RP_ID must be <OPERATOR_DOMAIN>.
OPERATOR_DOMAIN="ops.example.com"
# Separate recovery hostname. Caddy requires a client certificate on this host
# and overwrites X-Break-Glass-Verified before proxying to the application.
BREAK_GLASS_DOMAIN="break-glass.example.com"
ACME_EMAIL="ops@example.com"
# CA bundle that signs the offline break-glass client certificate. Mount the
# file into the caddy service at this path; never commit the private key.
BREAK_GLASS_CA_CERT_PATH="/etc/caddy/break-glass-ca.pem"

# The deployment env is the union of the root app .env.example (DATABASE_URL,
# PLATFORM_DATABASE_URL, TENANT_DATABASE_URL, REDIS_URL, CONTROL_*,
# NEXT_PUBLIC_API_URL, ...) and this file. NEXT_PUBLIC_API_URL must be the
# canonical operator origin (https://<OPERATOR_DOMAIN>) and is baked into the
# Platform build.
