{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "REDIS_URL",
    "NODE_ENV",
    "CONTROL_PLANE_ORIGIN",
    "CONTROL_WEBAUTHN_RP_ID",
    "CONTROL_SESSION_SECRET",
    "PLATFORM_DATABASE_URL",
    "TENANT_DATABASE_URL",
    "EDGE_TEAM_DOMAIN",
    "EDGE_AUDIENCE",
    "IMPERSONATION_MAX_MINUTES",
    "QUOTA_CACHE_TTL_SECONDS",
    "CATALOG_CACHE_TTL_SECONDS",
    "TRUSTED_PROXY_IPS",
    "SESSION_COOKIE_SAME_SITE",
    "PLATFORM_BOOTSTRAP_OPERATOR_EMAIL",
    "API_URL",
    "DOMAIN_ROOT",
    "MARKETING_HOST",
    "OPERATOR_HOST",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "NEXT_PUBLIC_API_URL",
    "PLATFORM_ERROR_TRACKING_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@suite/db#build": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#lint": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tests/**", "test/**"]
    },
    "coverage": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
