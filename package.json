{
  "name": "business-os-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Universal Composable Business Operating System (Business OS) - Modular Enterprise App Suite",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:dashboard": "pnpm --filter @suite/dashboard dev",
    "dev:api": "pnpm --filter @suite/api dev",
    "build:dashboard": "pnpm --filter @suite/dashboard build",
    "build:api": "pnpm --filter @suite/api build",
    "test:dashboard": "pnpm --filter @suite/dashboard test",
    "test:website-builder": "pnpm --filter @suite/website-builder test",
    "test:api": "pnpm --filter @suite/api test",
    "db:generate": "pnpm --filter @suite/db prisma:generate",
    "db:studio": "pnpm --filter @suite/db db:studio",
    "db:seed": "pnpm --filter @suite/db db:seed",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.4.2",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
