{
  "name": "business-os-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Universal Composable Business Operating System (Business OS) - Modular Enterprise App Suite",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:dashboard": "pnpm --filter @suite/dashboard dev",
    "dev:api": "pnpm --filter @suite/api dev",
    "dev:platform": "pnpm --filter @suite/platform dev",
    "dev:web": "pnpm --filter @suite/web dev",
    "start": "pnpm db:migrate:status && turbo run start",
    "start:api": "pnpm --filter @suite/api start",
    "start:dashboard": "pnpm --filter @suite/dashboard start",
    "start:platform": "pnpm --filter @suite/platform start",
    "start:web": "pnpm --filter @suite/web start",
    "serve": "pnpm build && pnpm start",
    "build:dashboard": "pnpm --filter @suite/dashboard build",
    "build:api": "pnpm --filter @suite/api build",
    "build:platform": "pnpm --filter @suite/platform build",
    "build:web": "pnpm --filter @suite/web build",
    "test:dashboard": "pnpm --filter @suite/dashboard test",
    "test:website-builder": "pnpm --filter @suite/website-builder test",
    "test:api": "pnpm --filter @suite/api test",
    "db:generate": "pnpm --filter @suite/db prisma:generate",
    "db:migrate": "pnpm --filter @suite/db db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @suite/db exec prisma migrate status --schema=prisma/schema",
    "db:studio": "pnpm --filter @suite/db db:studio",
    "db:seed": "pnpm --filter @suite/db db:seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:prune": "eslint . --prune-suppressions",
    "lint:p1": "eslint --no-config-lookup --config tooling/eslint-rules/p1-proof.config.mjs tooling/eslint-rules/fixtures/flag-status.bad.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run coverage --concurrency=1",
    "verify:diff": "git fetch origin dev && pnpm turbo run coverage --filter='[origin/dev]' --concurrency=1 && node tooling/quality/diff-coverage.mjs --base origin/dev",
    "test:rules": "node --test tooling/eslint-rules/*.test.mjs",
    "quality:perf-budgets": "node tooling/quality/validate-perf-budgets.mjs --budgets tooling/quality/perf-budgets.json --results",
    "knip": "knip",
    "knip:report": "knip --no-exit-code",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "depcruise:report": "depcruise apps packages --config .dependency-cruiser.cjs --output-type err-long || true",
    "dup:report": "jscpd --config .jscpd.json || true",
    "quality": "pnpm test:rules && pnpm lint && pnpm typecheck && pnpm test && pnpm knip:report",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --pass-on-unpruned-suppressions",
      "bash -c 'pnpm typecheck'"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
